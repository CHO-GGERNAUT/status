{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "status-preview-migrations",
  "compatibility_date": "2026-08-31",
  "d1_databases": [
    {
      "binding": "STATUS_DB",
      "database_name": "status-preview",
      "database_id": "replace-with-preview-database-id",
      "migrations_dir": "./migrations"
    }
  ]
}
