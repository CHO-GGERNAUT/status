[Unit]
Description=Send Ggernaut K3S status heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/ggernaut-status/k3s.env
ExecStart=/usr/local/libexec/ggernaut-status/status-k3s-reporter
TimeoutStartSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
