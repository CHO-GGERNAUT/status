#!/bin/sh
# For root-owned cron/configd configuration only. This file is shell code, not
# arbitrary user input; install it root:root 0600 in a root-owned directory.
set -eu
[ "$#" -eq 2 ] || { echo 'Usage: status-run-reporter /absolute/config.env host' >&2; exit 2; }
case "$1" in /*) ;; *) echo 'Configuration path must be absolute' >&2; exit 2 ;; esac
case "$2" in host) ;; *) echo 'Unknown reporter kind' >&2; exit 2 ;; esac
reporter_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
reporter_kind=$2
set -a
. "$1"
set +a
# configd/cron may omit FreeBSD's /usr/local/bin (curl). Preserve the
# caller's trusted PATH while supplying the standard router binary locations.
PATH="${PATH:-/usr/bin:/bin}:/usr/local/bin:/usr/local/sbin:/usr/sbin:/sbin"
export PATH
exec /bin/sh "$reporter_dir/status-$reporter_kind-reporter"
