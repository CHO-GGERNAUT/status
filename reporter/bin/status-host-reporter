#!/bin/sh
set -eu
. "$(dirname "$0")/status-common.sh"
status_validate
: "${STATUS_COMPONENT:?STATUS_COMPONENT is required}"
status_slug "$STATUS_COMPONENT" || status_fail 'Invalid component slug'

sequence=$(date +%s)
payload=$(printf \
  '{"sequence":%s,"observations":[{"component":"%s","status":"operational","message":"heartbeat"}]}' \
  "$sequence" \
  "$STATUS_COMPONENT")

status_send "$payload"
