#!/bin/sh
set -eu
. "$(dirname "$0")/status-common.sh"
status_validate

STATUS_K3S_BIN=${STATUS_K3S_BIN:-/usr/local/bin/k3s}
STATUS_K3S_KUBECONFIG=${STATUS_K3S_KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}
STATUS_K3S_DNS_NAMESPACE=${STATUS_K3S_DNS_NAMESPACE:-kube-system}
STATUS_K3S_DNS_WORKLOAD=${STATUS_K3S_DNS_WORKLOAD:-coredns}
STATUS_K3S_INGRESS_NAMESPACE=${STATUS_K3S_INGRESS_NAMESPACE:-platform-system}
STATUS_K3S_INGRESS_WORKLOAD=${STATUS_K3S_INGRESS_WORKLOAD:-traefik}

kc() {
  "$STATUS_K3S_BIN" kubectl --kubeconfig "$STATUS_K3S_KUBECONFIG" --request-timeout=5s "$@"
}

# Independently observe each component, even when /readyz fails. Use desired
# spec.replicas and an explicit delimiter: a missing readyReplicas means zero.
workload() {
  counts=$(kc --namespace "$1" get deployment "$2" \
    -o 'jsonpath={.status.readyReplicas}{"|"}{.spec.replicas}' 2>/dev/null) || counts='0|0'
  ready=${counts%%|*}
  desired=${counts#*|}
  ready=${ready:-0}
  desired=${desired:-0}
  case "$ready:$desired" in *[!0-9:]*) ready=0; desired=0 ;; esac
  result=outage
  if [ "$desired" -gt 0 ] && [ "$ready" -ge "$desired" ]; then
    result=operational
  elif [ "$ready" -gt 0 ]; then
    result=degraded
  fi
  printf '"status":"%s","message":"%s/%s replicas ready"' "$result" "$ready" "$desired"
}

api_status=outage
if kc get --raw=/readyz >/dev/null 2>&1; then
  api_status=operational
fi

node_states=$(kc get nodes \
  -o 'jsonpath={range .items[*]}{.metadata.name}{"|"}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{"\n"}{end}' \
  2>/dev/null) || node_states=''
node_total=$(printf '%s\n' "$node_states" | awk 'NF { count++ } END { print count + 0 }')
node_ready=$(printf '%s\n' "$node_states" | awk -F '|' '$2 == "True" { count++ } END { print count + 0 }')
nodes_status=outage
if [ "$node_total" -gt 0 ] && [ "$node_ready" -eq "$node_total" ]; then
  nodes_status=operational
elif [ "$node_ready" -gt 0 ]; then
  nodes_status=degraded
fi

dns=$(workload "$STATUS_K3S_DNS_NAMESPACE" "$STATUS_K3S_DNS_WORKLOAD")
ingress=$(workload "$STATUS_K3S_INGRESS_NAMESPACE" "$STATUS_K3S_INGRESS_WORKLOAD")
sequence=$(date +%s)
payload=$(printf \
  '{"sequence":%s,"observations":[{"component":"k3s-api","status":"%s","message":"API readiness"},{"component":"k3s-nodes","status":"%s","message":"%s/%s nodes ready"},{"component":"k3s-dns",%s},{"component":"k3s-ingress",%s}]}' \
  "$sequence" "$api_status" "$nodes_status" "$node_ready" "$node_total" "$dns" "$ingress")
status_send "$payload"
